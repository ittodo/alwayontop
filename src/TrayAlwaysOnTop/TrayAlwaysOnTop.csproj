<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TrayAlwaysOnTop</AssemblyName>
    <RootNamespace>TrayAlwaysOnTop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>Local</Authors>
    <Product>Tray Always On Top</Product>
    <Description>Pin any Windows desktop window above the others from a hotkey or tray menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\artifacts\TrayAlwaysOnTop-VSCode.vsix')">
    <Content Include="..\..\artifacts\TrayAlwaysOnTop-VSCode.vsix">
      <Link>Integrations\TrayAlwaysOnTop-VSCode.vsix</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\artifacts\TrayAlwaysOnTop-VisualStudio.vsix')">
    <Content Include="..\..\artifacts\TrayAlwaysOnTop-VisualStudio.vsix">
      <Link>Integrations\TrayAlwaysOnTop-VisualStudio.vsix</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
